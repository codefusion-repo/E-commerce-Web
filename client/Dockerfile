FROM node:18.17.0

ENV NODE_ENV=production

ARG NEXT_PUBLIC_API_KEY_FIREBASE
ARG NEXT_PUBLIC_AUTH_DOMAIN_FIREBASE
ARG NEXT_PUBLIC_PROJECT_ID_FIREBASE
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET_FIREBASE
ARG NEXT_PUBLIC_SENDER_ID_FIREBASE
ARG NEXT_PUBLIC_APP_ID_FIREBASE
ARG NEXT_PUBLIC_MEASUREMENT_ID_FIREBASE

ARG NEXT_PUBLIC_URL_DOCKER
ARG NEXT_PUBLIC_URL_PRO
ARG NEXT_PUBLIC_AWS_S3_CUSTOM_DOMAIN

ARG NEXT_PUBLIC_GOOGLE_MAPS
ARG NEXT_PUBLIC_MAP_ID 

ENV NEXT_PUBLIC_API_KEY_FIREBASE=$NEXT_PUBLIC_API_KEY_FIREBASE
ENV NEXT_PUBLIC_AUTH_DOMAIN_FIREBASE=$NEXT_PUBLIC_AUTH_DOMAIN_FIREBASE
ENV NEXT_PUBLIC_PROJECT_ID_FIREBASE=$NEXT_PUBLIC_PROJECT_ID_FIREBASE
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET_FIREBASE=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET_FIREBASE
ENV NEXT_PUBLIC_SENDER_ID_FIREBASE=$NEXT_PUBLIC_SENDER_ID_FIREBASE
ENV NEXT_PUBLIC_APP_ID_FIREBASE=$NEXT_PUBLIC_APP_ID_FIREBASE
ENV NEXT_PUBLIC_MEASUREMENT_ID_FIREBASE=$NEXT_PUBLIC_MEASUREMENT_ID_FIREBASE

ENV NEXT_PUBLIC_URL_DOCKER=$NEXT_PUBLIC_URL_DOCKER
ENV NEXT_PUBLIC_URL_PRO=$NEXT_PUBLIC_URL_PRO
ENV NEXT_PUBLIC_AWS_S3_CUSTOM_DOMAIN=$NEXT_PUBLIC_AWS_S3_CUSTOM_DOMAIN

ENV NEXT_PUBLIC_GOOGLE_MAPS=$NEXT_PUBLIC_GOOGLE_MAPS 
ENV NEXT_PUBLIC_MAP_ID=$NEXT_PUBLIC_MAP_ID

WORKDIR /client

COPY . /client/

RUN npm install \
    && npm run build

EXPOSE 3000

EXPOSE 3000

CMD ["npx", "next", "start", "-H", "0.0.0.0", "-p", "3000"]



